<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gantry_ros2_control" params="name prefix use_simulated_odrive can_interface">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_simulated_odrive}">
          <plugin>odrive_gantry_moveit_example/SimulatedOdriveHardware</plugin>
        </xacro:if>
        <xacro:unless value="${use_simulated_odrive}">
          <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
        </xacro:unless>
        <param name="can">${can_interface}</param>
        <param name="status_publish_rate">20.0</param>
        <param name="heartbeat_timeout">0.5</param>
        <param name="default_mode">position</param>
      </hardware>

      <joint name="${prefix}x_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="odrive_node_id">10</param>
        <param name="odrive_axis_index">0</param>
        <param name="lead_screw_pitch">1.0</param>
        <param name="max_velocity">1.0</param>
        <param name="max_acceleration">2.0</param>
      </joint>

      <joint name="${prefix}y_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="odrive_node_id">11</param>
        <param name="odrive_axis_index">0</param>
        <param name="lead_screw_pitch">1.0</param>
        <param name="max_velocity">1.0</param>
        <param name="max_acceleration">2.0</param>
      </joint>

      <joint name="${prefix}yaw_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="odrive_node_id">11</param>
        <param name="odrive_axis_index">1</param>
        <param name="gear_ratio">1.0</param>
        <param name="max_velocity">2.5</param>
        <param name="max_acceleration">4.0</param>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
